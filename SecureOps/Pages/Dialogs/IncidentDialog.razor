@using Gotho.BlazorPdf
@using Gotho.BlazorPdf.Config
@using MudBlazor
@using SecureOps.Models
@using SecureOps.Models.Dto
@using System.Text.Json
@using System.Text
@using MudBlazor.Extensions;
@using MudBlazor.Extensions.Options;
@inject HttpClient Http
@inject NavigationManager NavManager
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudDialog MaxWidth="MaxWidth.ExtraLarge" FullWidth="true" Class="custom-dialog blur dialog-background">

    <TitleContent>
        <MudText Typo="Typo.h5">Incident Details </MudText>
    </TitleContent>

    <DialogContent>
        <MudStack Row="true" Spacing="4">
            <!-- Left: PDF Viewer -->
            @if(ShowPdf){
            <MudItem xs="12" sm="6" Class="pa-2">
                @if (!string.IsNullOrEmpty(PdfUrl))
                {
              
                    <PdfViewer  Colors="PdfColors" Url="@PdfUrl" Height="700px" />
                }
                else
                {
                    <MudPaper Class="pa-4 d-flex justify-center align-center" Style="height:700px">
                        <MudText Typo="Typo.subtitle1" Align="Align.Center">PDF Preview will appear here</MudText>
                    </MudPaper>
                }
                
            </MudItem>
            }
            <!-- Right: Form -->

            <MudItem xs="12" sm="@(ShowPdf ? 6 : 12)">
                <MudForm @ref="form" Class="mt-0">
                    <MudStack Spacing="3">

                        <MudStack Row="true" AlignItems="AlignItems.Center">


                            <MudToggleIconButton @bind-Toggled="ShowPdf"
                     Icon="@Icons.Material.Filled.Visibility"
                     Color="@Color.Success"
                                                 ToggledIcon="@Icons.Material.Filled.VisibilityOff"
                     ToggledColor="@Color.Error"
                                                 title="@(ShowPdf ? "Show" : "Hide")" />


                            <!-- Left-aligned button -->
                            @* <MudButton Variant="Variant.Filled" Color="Color.Warning"
                                       StartIcon="@Icons.Material.Filled.FileDownload"
                                       OnClick="GeneratePdf">
                                Download PDF
                            </MudButton> *@
                            <MudSpacer />
                            @if ((incident.Status.ToString() == "In Progress" || incident.Status.ToString() == "Reported") && IncidentId != 0)
                            {
                                <MudButton Variant="Variant.Filled" Color="Color.Tertiary"
                                           StartIcon="@Icons.Material.Filled.Check"
                                           OnClick="VerifyIncident">
                                    Verify
                                </MudButton>
                            }
                            @if ((incident.Status.ToString() == "In Progress" || incident.Status.ToString() == "Reported" || incident.Status.ToString() == "Verified") && IncidentId != 0)
                            {
                                <MudButton Variant="Variant.Filled" Color="Color.Tertiary"
                                           StartIcon="@Icons.Material.Filled.Check"
                                           OnClick="ResolvedIncedent">
                                    Resolve Incident
                                </MudButton>
                            }
                        </MudStack>

                        <!-- Incident Fields -->
                        <MudPaper Class="pa-4 dialog-background-container">
                            <MudTextField @bind-Value="incident.Title" Label="Title" Required="true" For="@(() => incident.Title)" />
                        </MudPaper>

                        <MudPaper Class="pa-4 dialog-background-container">
                            <MudTextField @bind-Value="incident.Description" Label="Description" Required="true" For="@(() => incident.Description)" />
                        </MudPaper>

                        <MudGrid>
                            <MudItem xs="6">
                                <MudPaper Class="pa-4 dialog-background-container">
                                    <MudDatePicker Label="Incident Date" Required="true" ShowWeekNumbers="true" @bind-Date="incident.ReportedAt" />
                                </MudPaper>
                            </MudItem>

                            <MudItem xs="6">
                                <MudPaper Class="pa-4 dialog-background-container">
                                    <MudDatePicker Label="Resolved At" ShowWeekNumbers="true" @bind-Date="incident.ResolvedAt" />
                                </MudPaper>
                            </MudItem>

                            <MudItem xs="6">
                                <MudPaper Class="pa-4 dialog-background-container">
                                    <MudSelect @bind-Value="incident.Status" T="string" Label="Status"
                                               AdornmentIcon="@Icons.Material.Filled.ArrowDownward" AdornmentColor="Color.Primary">
                                        <MudSelectItem Value="@("In Progress")" />
                                        <MudSelectItem Value="@("Reported")" />
                                        <MudSelectItem Value="@("Verified")" />
                                        <MudSelectItem Value="@("Resolved")" />
                                    </MudSelect>
                                </MudPaper>
                            </MudItem>

                            <MudItem xs="6">
                                <MudPaper Class="pa-4 dialog-background-container">
                                    <MudSelect @bind-Value="incident.Severity" T="string" Label="Severity"
                                               AdornmentIcon="@Icons.Material.Filled.ArrowDownward" AdornmentColor="Color.Primary">
                                        <MudSelectItem Value="@("Low")" />
                                        <MudSelectItem Value="@("Medium")" />
                                        <MudSelectItem Value="@("High")" />
                                        <MudSelectItem Value="@("Critical")" />
                                    </MudSelect>
                                </MudPaper>
                            </MudItem>

                            <MudItem xs="12">
                                <MudPaper Class="pa-4 dialog-background-container">
                                    <MudTextField @bind-Value="incident.Location" Label="Location" Required="true" />
                                </MudPaper>
                            </MudItem>
                        </MudGrid>

                        <!-- File upload -->
                        <MudPaper Class="pa-4 dialog-background-container">
                            <MudFileUpload T="IReadOnlyList<IBrowserFile>" Accept=".png,.jpg" FilesChanged="UploadFiles2" MaximumFileCount="100">
                                <ActivatorContent>
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.CloudUpload">
                                        Upload Images
                                    </MudButton>
                                </ActivatorContent>
                            </MudFileUpload>

                            @if (files != null && imageUrls.Count > 0)
                            {
                                <MudList T="string" Class="d-flex flex-wrap">
                                    @foreach (var imageUrl in imageUrls)
                                    {
                                        <MudPaper Class="relative ma-2" Style="display:inline-block; position:relative;">
                                            <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Primary" Size="Size.Small"
                                                           Class="absolute -top-2 -right-2 z-10 bg-dark rounded-full shadow-md"
                                                           OnClick="@(() => ConfirmDelete(imageUrl))" />
                                            <MudImage Src="@imageUrl" Height="150" Elevation="25" Class="rounded-lg" />
                                        </MudPaper>
                                    }
                                </MudList>
                            }
                        </MudPaper>

                    </MudStack>
                </MudForm>
            </MudItem>
        </MudStack>
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Submit">Save</MudButton>
    </DialogActions>
</MudDialog>





<style>
    .custom-dialog {
    width: 1300px !important;
    max-width: 90vw;
    }

    .blur {
    backdrop-filter: blur(10px);
    }

    .dialog-background {
    background-color: transparent;
    }

    .dialog-background-title {
    background: rgb(from var(--mud-palette-info-lighten) r g b / 50%);
    color: var(--mud-palette-white);
    }

    .dialog-background-surface {
    background: rgb(from var(--mud-palette-surface) r g b / 45%);
    }

    .dialog-background-container {
    background: rgb(from var(--mud-palette-surface) r g b / 85%);
    }

</style>

@code {

    

    public bool ShowPdf { get; set; } = false;

    private PdfViewer _pdfViewer;

    private BlazorPdfColors PdfColors { get; set; } = new()
    {
        Background = "#2e2d2d",
        Toolbar = "#423e3e",
        Icon = "#f1f4f8",
    };


    string PdfUrl = string.Empty;

    private async Task GeneratePdf()
    {

        if (IncidentId != 0)
            NavManager.NavigateTo(NavManager.BaseUri + $"api/Incident/{IncidentId}/pdf", forceLoad: true);



    }
    string url;
    private List<string> savedPaths = new List<string>();
    IList<IBrowserFile> files = new List<IBrowserFile>();
    private List<string> imageUrls = new List<string>();
    private MudMessageBox _mudMessageBox;
    private bool _state = false;
    string folderPath = string.Empty;
    string FolderIncidentID = string.Empty;


    private async Task ConfirmDelete(string imageUrl)
    {
        bool? result = await DialogService.ShowMessageBox(
            "Warning",
            "Deleting can not be undone!",
            yesText: "Delete!", cancelText: "Cancel");





        if (result != null)
        {
            await DeleteImageAsync(imageUrl);
        }
    }




    private async Task OnButtonClickedAsync(string relativePath)
    {
        bool? result = await _mudMessageBox.ShowAsync();
        _state = result is null ? false : true;

        if (_state)
        {

            var response = await Http.DeleteAsync(NavManager.BaseUri + $"api/incident/DeleteImage?relativePath={Uri.EscapeDataString(relativePath)}");

            if (response.IsSuccessStatusCode)
            {
                imageUrls.Remove(relativePath); 
                StateHasChanged();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
            }
            Snackbar.Add("Deleted Successfully!", Severity.Success);

        }
        StateHasChanged();
    }


    private async Task DeleteImageAsync(string relativePath)
    {
        int index = imageUrls.IndexOf(relativePath);
        if (index < 0) return; // safety check

        if (relativePath.StartsWith("\\photos") )
        {
            // This is a saved image on the server
            var response = await Http.DeleteAsync(
                NavManager.BaseUri + $"api/incident/DeleteImage?relativePath={Uri.EscapeDataString(relativePath)}");

            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"Error deleting image: {error}");
                return;
            }
        }
        else
        {
            // This is a newly uploaded image (Base64)
            if (index < files.Count)
                files.RemoveAt(index);
        }

        // Remove from UI list
        imageUrls.RemoveAt(index);
        StateHasChanged();
    }

    private async Task UploadFiles2(IReadOnlyList<IBrowserFile> files)
    {
        foreach (var file in files)
        {
            this.files.Add(file);

            using var stream = file.OpenReadStream(10 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);

            var bytes = ms.ToArray();
            var imageBase64 = Convert.ToBase64String(bytes);
            var imageUrl = $"data:{file.ContentType};base64,{imageBase64}";
            imageUrls.Add(imageUrl);

            StateHasChanged();
        }
    }

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; }
    [Parameter] public int IncidentId { get; set; }
    [Parameter] public int EmployeeId { get; set; }

    private Employee employee;
    private CompanyDto company;
    private MudForm form;
    private Incident incident = new Incident();

    private async void VerifyIncident()
    {

        try
        {
            var response = await Http.PostAsync(
                NavManager.BaseUri + $"api/Incident/VerifyIncident?incidentId={IncidentId}&verifiedById={EmployeeId}",
                null
            );       //     var response = await Http.PutAsync(url, null); // no body needed

            if (response.IsSuccessStatusCode)
            {
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"Error: {error}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Exception: {ex.Message}");
        }

     


       // await SaveIncident();
    }
       private async void ResolvedIncedent()
    {

        try
        {
            var response = await Http.PostAsync(
                NavManager.BaseUri + $"api/Incident/ResolveIncident?incidentId={IncidentId}&verifiedById={EmployeeId}",
                null
            );       //     var response = await Http.PutAsync(url, null); // no body needed

            if (response.IsSuccessStatusCode)
            {
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"Error: {error}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Exception: {ex.Message}");
        }

     


      //  await SaveIncident();
    }
    
    private async void Submit()
    {
        await SaveIncident();
    }

    private void Cancel() => MudDialog.Cancel();

    protected override async Task OnInitializedAsync()
    {
        PdfUrl = NavManager.BaseUri + $"api/Incident/{IncidentId}/ViewPdf";

      //  await _pdfViewer.LoadPdfAsync(PdfUrl);
        


        var token = await LocalStorage.GetItemAsync<string>("authToken");
        EmployeeId = JwtHelper.DecodeTokenToEmployee(token).Id;
        company = JwtHelper.DecodeTokenToCompany(token);

        if (IncidentId != 0)
        {
            Incident tempIncident = await Http.GetFromJsonAsync<Incident>(NavManager.BaseUri + $"api/incident/GetIncident?IncidentId={IncidentId}");
            incident = tempIncident;

            string FolderPathHolder = "";
            if (incident != null && incident.PhotoPath != null)
            {
                FolderPathHolder = incident.PhotoPath.StartsWith(@"wwwroot\")
                    ? incident.PhotoPath.Substring(@"wwwroot\".Length)
                    : incident.PhotoPath;

                string[] filePaths = Directory.GetFiles(FolderPathHolder);
                foreach (var filePath in filePaths)
                {
                    string relativePath = "";
                    int index = filePath.IndexOf("wwwroot");
                    if (index >= 0)
                    {
                        relativePath = filePath.Substring(index + "wwwroot".Length);
                    }
                    imageUrls.Add(relativePath);
                }
            }
        }
        else
        {
            //incident.Id = await Http.GetFromJsonAsync<int>(NavManager.BaseUri + $"api/incident/GetNextIncidentID");
        }
    }

    private async Task SaveIncident()
    {
        await form.Validate();
        if (!form.IsValid)
            return;

        incident.EmployeeId = EmployeeId;
        if (incident.ReportedAt == default)
            incident.ReportedAt = DateTime.Now;

        IncidentWithEmpDto dto = new IncidentWithEmpDto
            {
                Description = incident.Description,
                ReportedAt = incident.ReportedAt,
                ResolvedAt = incident.ResolvedAt,
                Location = incident.Location,
                Severity = incident.Severity,
                CreatedById = EmployeeId,
                Title = incident.Title,
                Status = incident.Status,
                EmpId = incident.EmployeeId,
                PhotoPath = incident.PhotoPath,
                Id = incident.Id,
                CompanyId = company.Id
            };

        bool okay = true;
        if (files.Count() != 0)
        {

            bool first = true;
            foreach (var file in files)
            {
                using var content = new MultipartFormDataContent();

                if (first)
                {

                    first = false;
                }
                else
                {
                    dto.Id =  await Http.GetFromJsonAsync<int>(NavManager.BaseUri + $"api/incident/GetCurrentIncidentID");
                    incident.Id = await Http.GetFromJsonAsync<int>(NavManager.BaseUri + $"api/incident/GetCurrentIncidentID");
                   

                    
                }

                var dtoJson = new StringContent(JsonSerializer.Serialize(dto), Encoding.UTF8, "application/json");
                content.Add(dtoJson, "dtoJson");
                

                var streamContent = new StreamContent(file.OpenReadStream(maxAllowedSize: 200_000_000));
                streamContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);
                content.Add(streamContent, "files", file.Name);

                var response = await Http.PostAsync(NavManager.BaseUri + "api/incident/UpsertIncident", content);
                if (!response.IsSuccessStatusCode)
                {
                    okay = false;
                }
            }
        }
        else
        {
            using var content = new MultipartFormDataContent();

            var dtoJson = new StringContent(JsonSerializer.Serialize(dto), Encoding.UTF8, "application/json");
            content.Add(dtoJson, "dtoJson");

            var response = await Http.PostAsync(NavManager.BaseUri + "api/incident/UpsertIncident", content);
            if (!response.IsSuccessStatusCode)
            {
                okay = false;
            }
        }

        if (okay)
        {
            MudDialog.Close(DialogResult.Ok(true));
        }
    }
}
