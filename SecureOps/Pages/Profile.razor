    private async Task HandleAvatarUploaded(string newAvatarUrl)
    {
        // Update your avatar URL and refresh the UI
        avatarUrl = newAvatarUrl;
        await InvokeAsync(StateHasChanged);
    }



    private EmployeeDto? employeeDto;
    private bool isLoading = true;
    private bool empExist = false;
    private string? avatarUrl;
    private bool ShowAvatarDialog = false;
    private DateTime lastUpdated = DateTime.Now;
    User user1;
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            var token = await LocalStorage.GetItemAsync<string>("authToken");
            user1 = JwtHelper.DecodeTokenToUser(token);
            var employeeIdClaim = user.FindFirst("employeeId")?.Value;
            empExist = int.TryParse(employeeIdClaim, out var empId);

            if (empExist && empId > 0)
            {
                employeeDto = await JwtHelper.DecodeFromDatabaseTokenToEmployeeAsync(token, Http, NavManager.BaseUri);
                avatarUrl = await new FilesHelper(NavManager.BaseUri, empId).GetAvatarUrlAsync();

                // Set default avatar if none exists
                if (string.IsNullOrEmpty(avatarUrl))
                {
                    avatarUrl = "/images/default-avatar.png";
                }
            }
            else
            {
                empExist = false;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load profile: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private List<Role> GetUserRoles()
    {

        List<Role> roles = new List<Role>();
        // Implement based on your role system
        foreach(var role in user1.Roles)
        {
            roles.Add(role);
        }
        return roles ;
    }

