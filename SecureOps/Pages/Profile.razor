@page "/profile"
@using MudBlazor
@using SecureOps.Models
@using SecureOps.Models.Dto
@using SecureOps.Pages.Dialogs
@using SecureOps.Services.NewFolder
@inject HttpClient Http
@inject NavigationManager NavManager
@inject ISnackbar Snackbar
@inject JwtAuthenticationStateProvider AuthStateProvider
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@using MudBlazor
@using SecureOps.Models
@using SecureOps.Models.Dto
@using SecureOps.Services.NewFolder
@inject HttpClient Http
@inject NavigationManager NavManager
@inject ISnackbar Snackbar
@inject JwtAuthenticationStateProvider AuthStateProvider
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@inject IDialogService DialogService

<MudContainer MaxWidth="MaxWidth.Large" Class="py-8">
    <MudPaper Class="p-6" Elevation="8" Rounded="true">
        @if (isLoading)
        {
            <div class="flex flex-col items-center justify-center py-16">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
                <MudText Typo="Typo.h6" Class="mt-4">Loading your profile...</MudText>
            </div>
        }
        else if (!empExist)
        {
            <div class="text-center py-8">
                <MudIcon Icon="Icons.Material.Filled.PersonAdd" Size="Size.Large" Color="Color.Warning" Class="mb-4" />
                <MudText Typo="Typo.h5" Color="Color.Warning" Class="mb-2">Profile Setup Required</MudText>
                <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-6">
                    You need to complete your employee profile to access all features.
                </MudText>
                <MudButton Variant="Variant.Filled" 
                          Color="Color.Primary" 
                          Size="Size.Large"
                          EndIcon="Icons.Material.Filled.ArrowForward"
                          OnClick="GoToEmployeeSetup">
                    Get Started
                </MudButton>
            </div>
        }
        else
        {
            <!-- Header Section -->
            <div class="flex flex-col md:flex-row items-center gap-6 mb-6">
                <div class="relative">
                    <MudAvatar Size="Size.Large" Elevation="8" Class="rounded-full border-1 border-white shadow-lg">
                        <MudImage Src="@avatarUrl" Class="rounded-full" Height="120" Width="120" />
                    </MudAvatar>
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" 
                                  Color="Color.Primary" 
                                  Size="Size.Small"
                                  Variant="Variant.Filled"
                                  Class="absolute bottom-0 right-0 transform translate-x-1/4 translate-y-1/4 shadow-md"
                                   OnClick="@(() => OpenAvatarDialog())" />
                </div>
                
                <div class="text-center md:text-left flex-1">
                    <MudText Typo="Typo.h4" Class="font-bold mb-1">@employeeDto.FullName</MudText>
                    <MudText Typo="Typo.subtitle1" Color="Color.Secondary" Class="mb-2">@employeeDto.Email</MudText>
                    @foreach (Role role in GetUserRoles())
                    {
                        <MudChip   Variant="Variant.Filled" 
                                 Color="Color.Success" 
                                 Size="Size.Small" T="string" >
                            @role.RoleName
                        </MudChip>


                    }
                 
              
                
                </div>
            </div>

            <MudDivider Class="my-6" />

            <!-- Profile Information Grid -->
            <MudGrid Spacing="3" Class="px-2">
                <!-- Row 1 -->
                <MudItem xs="12" sm="6">
                    <MudCard Elevation="2" Class="h-full">
                        <MudCardContent>
                            <div class="flex items-center gap-3">
                                <MudIcon Icon="@Icons.Material.Filled.Badge" Color="Color.Primary" />
                                <div>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Employee ID</MudText>
                                    <MudText Typo="Typo.body1" Class="font-medium">@employeeDto.Id</MudText>
                                </div>
                            </div>
                        </MudCardContent>
                    </MudCard>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudCard Elevation="2" Class="h-full">
                        <MudCardContent>
                            <div class="flex items-center gap-3">
                                <MudIcon Icon="@Icons.Material.Filled.Phone" Color="Color.Info" />
                                <div>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Phone</MudText>
                                    <MudText Typo="Typo.body1" Class="font-medium">
                                        @(string.IsNullOrEmpty(employeeDto.PhoneNumber) ? "Not provided" : employeeDto.PhoneNumber)
                                    </MudText>
                                </div>
                            </div>
                        </MudCardContent>
                    </MudCard>
                </MudItem>

                <!-- Row 2 -->
                <MudItem xs="12" sm="6">
                    <MudCard Elevation="2" Class="h-full">
                        <MudCardContent>
                            <div class="flex items-center gap-3">
                                <MudIcon Icon="@Icons.Material.Filled.Business" Color="Color.Warning" />
                                <div>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Department</MudText>
                                    <MudText Typo="Typo.body1" Class="font-medium">
                                        @(string.IsNullOrEmpty(employeeDto.Department) ? "Not assigned" : employeeDto.Department)
                                    </MudText>
                                </div>
                            </div>
                        </MudCardContent>
                    </MudCard>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudCard Elevation="2" Class="h-full">
                        <MudCardContent>
                            <div class="flex items-center gap-3">
                                <MudIcon Icon="@Icons.Material.Filled.Work" Color="Color.Success" />
                                <div>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Position</MudText>
                                    <MudText Typo="Typo.body1" Class="font-medium">
                                        @(string.IsNullOrEmpty(employeeDto.JobTitle) ? "Not specified" : employeeDto.JobTitle)
                                    </MudText>
                                </div>
                            </div>
                        </MudCardContent>
                    </MudCard>
                </MudItem>

                <!-- Additional Info Row -->
                <MudItem xs="12">
                    <MudCard Elevation="2">
                        <MudCardContent>
                            <div class="flex items-center gap-3">
                                <MudIcon Icon="@Icons.Material.Filled.Info" Color="Color.Tertiary" />
                                <div class="flex-1">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Additional Information</MudText>
                                    <MudText Typo="Typo.body2" Class="text-gray-600">
                                        Profile last updated: @lastUpdated.ToString("MMM dd, yyyy")
                                    </MudText>
                                </div>
                            </div>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            </MudGrid>

            <MudDivider Class="my-6" />

            <!-- Action Buttons -->
            <div class="flex flex-col sm:flex-row gap-3 justify-end">
                <MudButton Variant="Variant.Outlined" 
                          Color="Color.Secondary" 
                          StartIcon="@Icons.Material.Filled.Download"
                          OnClick="ExportProfile">
                    Export Profile
                </MudButton>
                <MudButton Variant="Variant.Filled" 
                          Color="Color.Primary" 
                          StartIcon="@Icons.Material.Filled.Edit"
                          OnClick="EditProfile">
                    Edit Profile
                </MudButton>
            </div>
        }
    </MudPaper>
</MudContainer>


