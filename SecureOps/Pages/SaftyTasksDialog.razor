    private async Task OnButtonClickedAsync(string relativePath)
    {
        bool? result = await _mudMessageBox.ShowAsync();
        _state = result is null ? false : true;

        if (_state)
        {

            var response = await Http.DeleteAsync(NavManager.BaseUri + $"api/incident/DeleteImage?relativePath={Uri.EscapeDataString(relativePath)}");

            if (response.IsSuccessStatusCode)
            {
             
                StateHasChanged();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
            }
            Snackbar.Add("Deleted Successfully!", Severity.Success);

        }
        StateHasChanged();
    }





    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; }
    [Parameter] public int SaftyTaskId { get; set; }
    [Parameter] public int EmployeeId { get; set; }

    private Employee employee;
    private MudForm form;
    private SafetyTask safetyTask = new SafetyTask();

    private async void Submit()
    {
        await SaveSafetyTask();
    }

    private void Cancel() => MudDialog.Cancel();

    protected override async Task OnInitializedAsync()
    {
        var token = await LocalStorage.GetItemAsync<string>("authToken");
        EmployeeId = JwtHelper.DecodeTokenToEmployee(token).Id;

        if (SaftyTaskId != 0)
        {
            SafetyTask tempSafetyTask = await Http.GetFromJsonAsync<SafetyTask>(NavManager.BaseUri + $"api/SafetyTask/GetSafetyTask?SafetyTaskId={SaftyTaskId}");
            safetyTask = tempSafetyTask;

       
        }
        else
        {
        }
    }

    private async Task SaveSafetyTask()
    {
        await form.Validate();
        if (!form.IsValid)
            return;
        bool okay = true;
        safetyTask.EmployeeId = EmployeeId;
        using var content = new MultipartFormDataContent();
        var safetyTaskJson = new StringContent(JsonSerializer.Serialize(safetyTask), Encoding.UTF8, "application/json");
        content.Add(safetyTaskJson, "safetyTaskJson");

        var response = await Http.PostAsync(NavManager.BaseUri + "api/SaftyTask/UpsertSaftyTask", content);
        if (!response.IsSuccessStatusCode)
        {
            okay = false;
        }
   

     
         
        

        if (okay)
        {
            MudDialog.Close(DialogResult.Ok(true));
        }
    }
}
