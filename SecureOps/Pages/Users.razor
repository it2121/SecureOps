@page "/users"
@using MudBlazor
@using SecureOps.Models.Dto
@using MudBlazor.Utilities

@inject HttpClient Http
@inject NavigationManager NavManager

<h3 class="mb-3">All Users</h3>


@if (userdto == null)
{
    <p>Loading users...</p>
}
else if (!userdto.Any())
{
    <p>No users found.</p>
}
else
{
    <MudTextField @bind-Value="_searchString" Placeholder="Search users..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="mb-3" />

    <MudSimpleTable Items="FilteredUsers" Hover="true" Dense="true" FixedHeader="true" Style="@(true ? "height:300px;" : "")">
        <thead>
            <tr>
                <th>Email</th>
                <th>Full Name</th>
                <th>Username</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in FilteredUsers)
            {
                <tr>
                    <td>@user.Email</td>
                    <td>@user.FullName</td>
                    <td>@user.Username</td>
                </tr>
            }
        </tbody>
    </MudSimpleTable>


}

@code {


   // private List<User> user;
    private List<UserDto> userdto;
    private string _colorValue;
    private string _searchString = "";
   
    protected override async Task OnInitializedAsync()
    {
        userdto = await Http.GetFromJsonAsync<List<UserDto>>(NavManager.BaseUri + "api/users/GetAll");
    }
    private IEnumerable<UserDto> FilteredUsers =>
            string.IsNullOrWhiteSpace(_searchString)
                ? userdto
                : userdto.Where(u =>
                    (u.Email?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (u.FullName?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (u.Username?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false));
}
