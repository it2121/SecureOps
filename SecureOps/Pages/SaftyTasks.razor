@page "/SaftyTasks"
@using MudBlazor
@using SecureOps.Models
@using SecureOps.Models.Dto
@using MudBlazor.Utilities
@inject HttpClient Http
@inject NavigationManager NavManager
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@using System.Net.Http.Json
@inject HttpClient httpClient
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@using MudBlazor.Extensions.Core
@using MudBlazor.Extensions.Helper
@using MudBlazor.Utilities
@using SecureOps.Data
@using SecureOps.Models
@inject AppDbContext _context
@inject NavigationManager NavManager
@inject NavigationManager NavManager
@inject HttpClient Http
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@using MudBlazor.Extensions;
@using MudBlazor.Extensions.Options;
<h3> Safety Tasks  </h3>


@if (safetyTask == null)
{
    <p>Loading Data...</p>
}
else if (!safetyTask.Any())
{
      <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
        <MudText Typo="Typo.h5"></MudText>



        <AuthorizeView Roles="Manager">

            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="@(() => OpenPageDialogAsync())">
                + Add New

            </MudButton>



        </AuthorizeView>
    </MudStack>
    <p>No Data found.</p>
}
else
{


    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
        <MudText Typo="Typo.h5"></MudText>
        <AuthorizeView Roles="Manager">

            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="@(() => OpenPageDialogAsync())">
                + Add New

            </MudButton>



        </AuthorizeView>
    </MudStack>
    <MudDataGrid ReadOnly="false"
                 @ref="grid"
                 T="SafetyTask"
                 MultiSelection="true"
                 Items="@safetyTask"
                 SortMode="SortMode.Multiple"
                 QuickFilter="@_quickFilter"
                 DragDropColumnReordering="true"
                 ColumnsPanelReordering="true"
                 Filterable="true" Groupable="true"
                 ShowMenuIcon="true"
                 Hideable="true" RowClick="@RowClicked"
                 RowContextMenuClick="RowRightClicked"
                 SelectedItemsChanged="@SelectedItemsChanged">
        <ToolBarContent>
            <MudText Typo="Typo.h6"> Tasks </MudText>
            <MudSpacer />
            <MudTextField @bind-Value="_searchString" Placeholder="Search" Adornment="Adornment.Start" Immediate="true"
                          AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
        </ToolBarContent>
        <Columns>
            <SelectColumn T="SafetyTask" />
            <PropertyColumn Property="x => x.Title" Title="Title" />
            <PropertyColumn Property="x => x.Status" Title="Status" />
            <PropertyColumn Property="x => x.DueDate" Title="DueDate" />

      
            <TemplateColumn Title="Employee">
                <CellTemplate>

                    @if (@context.Item.Employee != null)
                    {
                        <MudChip Icon="@Icons.Material.Filled.VerifiedUser" Color="Color.Info" Class="m-1">
                            @context.Item.Employee?.FullName

                        </MudChip>
                    }
                    else
                    {

                        <MudChip Icon="@Icons.Material.Filled.Pending" Color="Color.Error" Class="m-1">
                            unassigned

                        </MudChip>
                        
                    }
                     
                    
                </CellTemplate>
            </TemplateColumn>

            <!-- Action Button Column -->
            <TemplateColumn Title=" " CellClass="">
                <CellTemplate>
                    <MudButton Color="Color.Info"
                               Variant="Variant.Filled"
                               Size="Size.Small"
                               OnClick="@(async () => await OpenAEDialogAsync(context.Item.Id))">






                        Assign Employee
                    </MudButton>
                </CellTemplate>
                </TemplateColumn>
            <TemplateColumn Title=" " CellClass="">

                 
                <CellTemplate>
                    <MudButton Color="Color.Primary"
                               Variant="Variant.Filled"
                               Size="Size.Small"
                               OnClick="@(async () => await OpenDialogAsync(context.Item.Id))">






                        View
                    </MudButton>
                </CellTemplate>
            </TemplateColumn>


        </Columns>
        <PagerContent>
            <MudDataGridPager T="SafetyTask" />
        </PagerContent>
    </MudDataGrid>

}
@code {

  
    private async Task OpenPageDialogAsync()
    {

        var options = new DialogOptions { CloseOnEscapeKey = true, CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var parameters = new DialogParameters
        {
             { "SaftyTaskId", 0 } ,
            // pass the variable
        };


        var dialog = await DialogService.ShowAsync<SaftyTasksDialog>("Dialog", parameters, options);

        // Wait for dialog to close and get result
        var result = await dialog.Result;

        if (!result.Canceled)
        {

            
            var token = await LocalStorage.GetItemAsync<string>("authToken");

            if (!string.IsNullOrEmpty(token))
            {
             
                UserDto? currentUser = JwtHelper.DecodeTokenToUser(token);







                if (currentUser.Roles.Any(r =>
                   r.RoleName.Equals("Admin", StringComparison.OrdinalIgnoreCase)))
                {
                    safetyTask = await Http.GetFromJsonAsync<List<SafetyTask>>(NavManager.BaseUri + $"api/SaftyTask/GetAll");
                   
                }
                else
                {
                    safetyTask = await Http.GetFromJsonAsync<List<SafetyTask>>(NavManager.BaseUri + $"api/SaftyTask/GetSaftyTaskOfEmployee?EmpID={employee.Id}");
                }
            }
            StateHasChanged();
            return;
        }
        else
        {
            return;
        }

    }
