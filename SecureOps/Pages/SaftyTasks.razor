    public MudDataGrid<SafetyTask> grid = null;

    private async Task HideColumnsAsync(bool hide)
    {
        foreach (var column in grid.RenderedColumns)
        {
            if (hide)
            {
                await column.HideAsync();
            }
            else
            {
                await column.ShowAsync();
            }
        }
        ;
    }


    private IEnumerable<SafetyTask> safetyTask = new List<SafetyTask>();
    // private List<SDocumentDto> sdocumentDto;
    private string _searchString;
    private bool _sortNameByLength;
    private List<string> _events = new();
    // custom sort by name length
    private Func<SafetyTask, object> _sortBy => x =>
    {
        if (_sortNameByLength)
            return x.Title.Length;
        else
            return x.Status;
    };
    // quick filter - filter globally across multiple columns with the same input
    private Func<SafetyTask, bool> _quickFilter => x =>
    {
        if (string.IsNullOrWhiteSpace(_searchString))
            return true;

        if (x.Title.Contains(_searchString, StringComparison.OrdinalIgnoreCase))
            return true;

        if (x.Status.Contains(_searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        // if (x.Roles.ro.Contains(_searchString, StringComparison.OrdinalIgnoreCase))
        //     return true;

       

        // check roles
        // if (x.Employee != null && x.Roles.Any(r =>
        //     r.RoleName.Contains(_searchString, StringComparison.OrdinalIgnoreCase)))
        //     return true;

        return false;
    };


    // events
    void RowClicked(DataGridRowClickEventArgs<SafetyTask> args)
    {
        _events.Insert(0, $"Event = RowClick, Index = {args.RowIndex}, Data = {System.Text.Json.JsonSerializer.Serialize(args.Item)}");



    }

    void RowRightClicked(DataGridRowClickEventArgs<SafetyTask> args)
    {
        _events.Insert(0, $"Event = RowRightClick, Index = {args.RowIndex}, Data = {System.Text.Json.JsonSerializer.Serialize(args.Item)}");
    }

    void SelectedItemsChanged(HashSet<SafetyTask> items)
    {
        _events.Insert(0, $"Event = SelectedItemsChanged, Data = {System.Text.Json.JsonSerializer.Serialize(items)}");
    }




    // private List<User> user;
    private string _colorValue;
    private Employee employee;
    protected override async Task OnInitializedAsync()
    {
        var token = await LocalStorage.GetItemAsync<string>("authToken");

        if (!string.IsNullOrEmpty(token))
        {
            employee = JwtHelper.DecodeTokenToEmployee(token);
            UserDto? currentUser = JwtHelper.DecodeTokenToUser(token);







            if (currentUser.Roles.Any(r =>
               r.RoleName.Equals("Admin", StringComparison.OrdinalIgnoreCase)))
            {
                safetyTask = await Http.GetFromJsonAsync<List<SafetyTask>>(NavManager.BaseUri + $"api/SaftyTask/GetAll");

            }
            else
            {
                safetyTask = await Http.GetFromJsonAsync<List<SafetyTask>>(NavManager.BaseUri + $"api/SaftyTask/GetSaftyTaskOfEmployee?EmpID={employee.Id}");
            }
        }



    }
    private IEnumerable<SafetyTask> Filtereddocuments =>
            string.IsNullOrWhiteSpace(_searchString)
                ? safetyTask
                : safetyTask.Where(u =>
                    (u.Title?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (u.Status?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false));



