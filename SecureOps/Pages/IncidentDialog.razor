@using MudBlazor
@using SecureOps.Models
@using SecureOps.Models.Dto
@using MudBlazor
@using SecureOps.Models
@using SecureOps.Models.Dto
@using System.Text.Json
@using System.Text
@inject HttpClient Http
@inject NavigationManager NavManager
@inject NavigationManager NavManager
@inject HttpClient Http
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage

<MudDialog Class=" custom-dialog blur dialog-background"
TitleClass="blur dialog-background-title"
ContentClass="dialog-background-surface py-10"
ActionsClass="dialog-background-surface">

    <TitleContent>
        <MudText Typo="Typo.h5">Incident</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="form" Class="mt-4">

            <MudStack Spacing="3">
                <MudPaper Class="pa-4">
                    <MudTextField @bind-Value="incident.Title" Label="Title"
                    Required="true" For="@(() => incident.Title)" />
                </MudPaper>
                <MudDivider />

                <MudPaper Class="pa-4">
                    <MudTextField @bind-Value="incident.Description" Label="Description"
                    Required="true" For="@(() => incident.Description)" />
                </MudPaper>

                <MudGrid>
                    <MudItem xs="6">
                        <MudPaper Class="pa-4">
                            <MudDatePicker Label="Incident Date"
                            Required="true" ShowWeekNumbers="true" @bind-Date="incident.ReportedAt" />
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="6">
                        <MudPaper Class="pa-4">
                            <MudSelect @bind-Value="incident.Status" AdornmentIcon="@Icons.Material.Filled.ArrowDownward" AdornmentColor="Color.Primary"
                            T="string" Label="Select Status">
                                <MudSelectItem Value="@("In Progress")" />
                                <MudSelectItem Value="@("Reported")" />
                                <MudSelectItem Value="@("Resolved")" />
                            </MudSelect>
                        </MudPaper>
                    </MudItem>
                </MudGrid>

                <MudPaper Class="pa-4">

                    <MudFileUpload T="IReadOnlyList<IBrowserFile>"
                    Accept=".png, .jpg"
                    FilesChanged="UploadFiles2"
                    MaximumFileCount="100">
                        <ActivatorContent>
                            <MudButton Variant="Variant.Filled"
                            Color="Color.Primary"
                            StartIcon="@Icons.Material.Filled.CloudUpload">
                                Only image files
                            </MudButton>
                        </ActivatorContent>
                    </MudFileUpload>



                    @if (savedPaths.Count > 0)
                    {
                        foreach (var savedPath in savedPaths)
                        {
                            @* <MudTextField Label="Saved Path" @bind-Value="savedPath" ReadOnly="true" /> *@



                            <MudImage Src=@savedPath
                            Width="180"
                            Elevation="25"
                            Class="rounded-lg ma-4" />

                        }
                    }


                    @if (files != null)
                    {
                        <MudList T="string">
                            @foreach (var imageUrl in imageUrls)
                            {
                                <MudImage Src="@imageUrl"
                                Width="180"
                                Elevation="25"
                                Class="rounded-lg ma-4" />
                            }
                        </MudList>



                    }


                </MudPaper>
            </MudStack>

        </MudForm>

    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="Cancel">
            Cancel
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Submit">
            Save
        </MudButton>

    </DialogActions>
</MudDialog>

<style>
    .custom-dialog {
    width: 1300px !important;
    max-width: 90vw; /* prevent overflow on small screens */
    }

    .blur {
    backdrop-filter: blur(10px);
    }

    .dialog-background {
    background-color: transparent;
    }

    .dialog-background-title {
    background: rgb(from var(--mud-palette-info-lighten) r g b / 50%);
    color: var(--mud-palette-white);
    }

    .dialog-background-surface {
    background: rgb(from var(--mud-palette-surface) r g b / 75%);
    }
</style>



@code {
    private List<string> savedPaths = new List<string>();
    IList<IBrowserFile> files = new List<IBrowserFile>();
    private List<string> imageUrls = new List<string>();

    string folderPath = string.Empty;
    string FolderIncidentID = string.Empty;

    private async Task UploadFiles2(IReadOnlyList<IBrowserFile> files)
    {

        foreach (var file in files)
        {
            this.files.Add(file);

            using var stream = file.OpenReadStream(10 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);

            var bytes = ms.ToArray();
            var imageBase64 = Convert.ToBase64String(bytes);
            var imageUrl = $"data:{file.ContentType};base64,{imageBase64}";
            imageUrls.Add(imageUrl);

   

            StateHasChanged();

        }
    }

    private void UploadFiles(IBrowserFile file)
    {
        incident.PhotoPath = file.Name;
        StateHasChanged();
        //files.Add(file);
        //TODO upload the files to the server
    }

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; }
    [Parameter] public int IncidentId { get; set; }   // receives from parent



    private async void Submit()
    {
        await SaveIncident();





    }

    private void Cancel() => MudDialog.Cancel();






    [Parameter] public int EmployeeId { get; set; }
    private Employee employee;
    protected override async Task OnInitializedAsync()
    {

        var token = await LocalStorage.GetItemAsync<string>("authToken");
        EmployeeId = JwtHelper.DecodeTokenToEmployee(token).Id;

        if (IncidentId != 0)
        {

            Incident tempIncident = await Http.GetFromJsonAsync<Incident>(NavManager.BaseUri + $"api/incident/GetIncident?IncidentId={IncidentId}");

            incident = tempIncident;

            string FolderPathHolder = "";
            if (incident != null)
                if (incident.PhotoPath != null)
                {
                    FolderPathHolder = incident.PhotoPath.StartsWith(@"wwwroot\")
            ? incident.PhotoPath.Substring(@"wwwroot\".Length)
            : incident.PhotoPath;



                    string[] filePaths = Directory.GetFiles(FolderPathHolder);
                    //imageUrls.Clear();
                    foreach (var filePath in filePaths)
                    {

                        string relativePath = "";

                        int index = filePath.IndexOf("wwwroot");
                        if (index >= 0)
                        {
                            relativePath = filePath.Substring(index + "wwwroot".Length);
                        }






                        imageUrls.Add(relativePath);

                    }

                }
        }
        else
        {

            incident.Id = await Http.GetFromJsonAsync<int>(NavManager.BaseUri + $"api/incident/GetNextIncidentID");


        }




    }
    private MudForm form;
    private Incident incident = new Incident();

    private async Task SaveIncident()
    {
        await form.Validate();
        if (!form.IsValid)
            return;

        incident.EmployeeId = EmployeeId;
        if (incident.ReportedAt == default)
            incident.ReportedAt = DateTime.Now;

        IncidentWithEmpDto dto = new IncidentWithEmpDto
            {

                Description = incident.Description,
                ReportedAt = incident.ReportedAt,
                Title = incident.Title,
                Status = incident.Status,
                EmpId = incident.EmployeeId,
                PhotoPath = incident.PhotoPath,
                Id = incident.Id
            };
        bool okay = true;
        foreach (var file in files)
        {
            using var content = new MultipartFormDataContent();

            // Add DTO as JSON string
            var dtoJson = new StringContent(JsonSerializer.Serialize(dto), Encoding.UTF8, "application/json");
            content.Add(dtoJson, "dtoJson");

            // Add files


            var streamContent = new StreamContent(file.OpenReadStream(maxAllowedSize: 200_000_000)); // 50 MB per file
            streamContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);
            content.Add(streamContent, "files", file.Name);


            var response = await Http.PostAsync(NavManager.BaseUri + "api/incident/UpsertIncident", content);
            if (response.IsSuccessStatusCode)
            {


             
            }
            else
            {
                okay=false; 
            }

          
        }
        if (okay)
        {
            MudDialog.Close(DialogResult.Ok(true));
        }

     





    }

    // private void Cancel()
    // {
    //     NavManager.NavigateTo($"/incidents/");
    // }





}