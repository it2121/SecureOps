        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Submit">
                Save
            </MudButton>

    </DialogActions>
</MudDialog>
@code {

    private string savedPath = string.Empty;

    private async Task UploadFiles2(IBrowserFile file)
    {
        // var file = File; // IBrowserFile

        if (file == null)
            return;

        // Ensure folder exists
        var folderPath = Path.Combine(Directory.GetCurrentDirectory(), "wwwroot\\photos");
        if (!Directory.Exists(folderPath))
            Directory.CreateDirectory(folderPath);

        // Create unique filename
        var timestamp = DateTime.Now.ToString("yyyyMMdd_HHmmss");
        var extension = Path.GetExtension(file.Name);
        var fileName = file.Name;
        var filePath = Path.Combine(folderPath, fileName);

        // Save file to server
        using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024); // 10MB max
        using var fs = new FileStream(filePath, FileMode.Create);
        await stream.CopyToAsync(fs);

        // Set the "path" to store in database or show to user
        savedPath = $"photos/{fileName}"; // relative path




        incident.PhotoPath = "wwwroot/"+savedPath;
    }

    private void UploadFiles(IBrowserFile file)
    {
        incident.PhotoPath = file.Name;
        StateHasChanged();
        //files.Add(file);
        //TODO upload the files to the server
    }

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; }
    [Parameter] public int IncidentId { get; set; }   // receives from parent



    private  async void Submit() 
    {
        await SaveIncident();





    }

    private void Cancel() => MudDialog.Cancel();






    [Parameter] public int EmployeeId { get; set; }
    private Employee employee;
    protected override async Task OnInitializedAsync()
    {

        var token = await LocalStorage.GetItemAsync<string>("authToken");
        EmployeeId = JwtHelper.DecodeTokenToEmployee(token).Id;

        if (IncidentId != 0)
        {
            // var response = await Http.GetAsync(NavManager.BaseUri + $"api/Users/GetNameFromEmail?email={email}");

            Incident tempIncident = await Http.GetFromJsonAsync<Incident>(NavManager.BaseUri + $"api/incident/GetIncident?IncidentId={IncidentId}");

            incident = tempIncident;
            if (incident != null)
            if (incident.PhotoPath != null){
             savedPath = incident.PhotoPath.StartsWith(@"wwwroot\")
            ? incident.PhotoPath.Substring(@"wwwroot\".Length)
            : incident.PhotoPath;

            }
        }




    }
    private MudForm form;
    private Incident incident = new Incident();

      private async Task SaveIncident()
    {
        await form.Validate();
        if (!form.IsValid)
            return;

        incident.EmployeeId = EmployeeId;
        if (incident.ReportedAt == default)
            incident.ReportedAt = DateTime.Now;

        IncidentWithEmpDto dto = new IncidentWithEmpDto
        {

            Description = incident.Description,
            ReportedAt = incident.ReportedAt,
            Title = incident.Title,
            Status = incident.Status,
            EmpId = incident.EmployeeId,
            PhotoPath = incident.PhotoPath,
            Id = incident.Id
        };
        var response = await Http.PostAsJsonAsync(NavManager.BaseUri + "api/incident/UpsertIncident", dto);

        if (response.IsSuccessStatusCode)
        {
            MudDialog.Close(DialogResult.Ok(true));
            // After saving, go back to employee incidents page
           // NavManager.NavigateTo($"/incidents/");
        }
        else
        {
        }





    }

    // private void Cancel()
