        @* <MudTextField @bind-Value="incident.PhotoPath" Label="Photo"
                      Required="true" For="@(() => incident.PhotoPath)" /> *@


            <!-- Only show image if PhotoPath is not null or empty -->
            @if (!string.IsNullOrEmpty(savedPath))
            {
                <MudImage @bind-Value="savedPath" Src=@savedPath
                          Width="332" Height="250"
                          Elevation="25"
                          Class="rounded-lg ma-4" />
            }


        <MudTextField @bind-Value="incident.Description" Label="Description"
                      Required="true" For="@(() => incident.Description)" />



        <MudDatePicker Label="Incident Date"
                       Required="true" ShowWeekNumbers="true" @bind-Date="incident.ReportedAt" />

        <MudSelect @bind-Value="incident.Status" AdornmentIcon="@Icons.Material.Filled.ArrowDownward" AdornmentColor="Color.Primary"
                   T="string" Label="Select Status">
            <MudSelectItem Value="@("In Progress")" />
            <MudSelectItem Value="@("Reported")" />
