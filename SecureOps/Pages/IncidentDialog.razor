                    </MudButton>
                </ActivatorContent>
                <SelectedTemplate>

                    <MudText Required="true" Icon="@Icons.Material.Filled.AttachFile" @bind-Value="incident.PhotoPath" For="@(() => incident.PhotoPath)">@incident.PhotoPath</MudText>
                        <MudTextField  @bind-Value="incident.PhotoPath" Label="Photo" Icon="@Icons.Material.Filled.AttachFile" ReadOnly="true"
                                      Required="true" For="@(() => incident.PhotoPath)"  />
                  
                </SelectedTemplate>
