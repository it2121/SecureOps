@page "/incidents"
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@using SecureOps.Data
@using SecureOps.Models
@inject AppDbContext _context
@inject NavigationManager NavManager
@inject NavigationManager NavManager
@inject HttpClient Http
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@inject IDialogService DialogService
@inject ISnackbar Snackbar
<h3>Employee Incidents</h3>



<MudPaper Class="pa-4">

    @if (employee == null)
    {
        <MudText Typo="Typo.body1">Loading...</MudText>
    }
    else
    {
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
            <MudText Typo="Typo.h5">@employee.FullName Incidents</MudText>
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="@(() => OpenDialogAsync(0))">
                + New Incident
            </MudButton>
        </MudStack>


        @if (incidents == null || !incidents.Any())
        {
            <MudText Typo="Typo.body1">No incidents found for this employee.</MudText>
        }
        else
        {
            <MudTextField @bind-Value="_searchString" Placeholder="Search Incedent..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="mb-3" />

            <MudSimpleTable   Items="FilteredUsers" Hover="true" Dense="true" FixedHeader="true" Style="@(true ? "height:500px;" : "")">
                <thead >
                    <tr>
                        <th>Title</th>
                        <th>Status</th>
                        <th>ReportedAt</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var incident in FilteredUsers)
                    {
                        <tr>
                            <td>@incident.Title</td>
                            <td>@incident.Status</td>
                            <td>@incident.ReportedAt.ToString()</td>
                            <td>
                                <MudButton Color="Color.Primary" FullWidth="true" Variant="Variant.Filled" Size="Size.Small" @onclick="@(() => OpenDialogAsync(incident.Id))">
                                    Edit
                                </MudButton>

                             

                            </td>
                            <td>
                            @*     <MudButton Color="Color.Error" FullWidth="true" Variant="Variant.Filled" Size="Size.Small" OnClick="@(() => DeleteIncident(incident.Id))">
                                    Delete
                                </MudButton> *@

                                <MudButton Variant="Variant.Filled" FullWidth="true"  Color="Color.Error" OnClick="@(() => OnButtonClickedAsync(incident.Id))">Delete</MudButton>

                            </td>
                            @* <td>
                                <MudButton @onclick="@(() => OpenDialogAsync(incident.Id))" Variant="Variant.Filled" Color="Color.Primary">
                                    Open simple dialog
                                </MudButton>
                            </td> *@
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }
    }






</MudPaper>

<MudMessageBox @ref="_mudMessageBox" Title="Warning" CancelText="Cancel">
    <MessageContent>
        Deleting can <b><i>not</i></b> be undone!
    </MessageContent>
    <YesButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.DeleteForever">Delete!</MudButton>
    </YesButton>
</MudMessageBox>


@code {
    private MudMessageBox _mudMessageBox;
    private bool _state =false;

    private async Task OnButtonClickedAsync(int incidentId)
    {
        bool? result = await _mudMessageBox.ShowAsync();
        _state = result is null ? false : true;

        if (_state)
        {

            var response = await Http.DeleteAsync(NavManager.BaseUri + $"api/incident/{incidentId}");

            if (response.IsSuccessStatusCode)
            {
                var incidentToRemove = incidents.FirstOrDefault(i => i.Id == incidentId);
                if (incidentToRemove is not null)
                    incidents.Remove(incidentToRemove);
                StateHasChanged();
            }
            Snackbar.Add("Deleted Successfully!", Severity.Success);

        }
        StateHasChanged();
    }
    private async Task DeleteIncident(int incidentId)
    {
        var response = await Http.DeleteAsync(NavManager.BaseUri + $"api/incident/{incidentId}");

        if (response.IsSuccessStatusCode)
        {

            var incidentToRemove = incidents.FirstOrDefault(i => i.Id == incidentId);
            if (incidentToRemove is not null)
                incidents.Remove(incidentToRemove);




            StateHasChanged();


        }

    }

    private void EditIncident(int incidentId)
    {
        NavManager.NavigateTo($"/incidentForm/{incidentId}");


    }
    private  async Task OpenDialogAsync( int incidentId)
    {

        var options = new DialogOptions { CloseOnEscapeKey = true, CloseButton = true };

       // var options = new DialogOptions { CloseOnEscapeKey = true };
        var parameters = new DialogParameters
        {
            { "IncidentId", incidentId }   // pass the variable
        };
        var dialog = await DialogService.ShowAsync<IncidentDialog>("Dialog", parameters,options);

        // Wait for dialog to close and get result
        var result = await dialog.Result;

        if (!result.Canceled)
        {

            incidents = await Http.GetFromJsonAsync<List<Incident>>(NavManager.BaseUri + $"api/incident/GetIncidentsOfEmployee?EmpID={employee.Id}")
             ?? new List<Incident>();





            var returnedValue = result.Data;

            if (incidentId ==0){
                Snackbar.Add($"Incident added Successfully!", Severity.Success);
            }
            else
            {
                Snackbar.Add($"Incident edited Successfully!", Severity.Success);

            }
            return ;
    }
    else
    {
            return ;
    }

    }


    private string _colorValue;
    private string _searchString = "";
    public int EmployeeId { get; set; }

    private Employee employee;
    private List<Incident> incidents = new();



    private IEnumerable<Incident> FilteredUsers =>
            string.IsNullOrWhiteSpace(_searchString)
                ? incidents
                : incidents.Where(u =>
                    (u.Status?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (u.Title?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (u.ReportedAt.ToString()?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false));







    protected override async Task OnInitializedAsync()
    {

        var token = await LocalStorage.GetItemAsync<string>("authToken");
        employee = JwtHelper.DecodeTokenToEmployee(token);


        incidents = await Http.GetFromJsonAsync<List<Incident>>(NavManager.BaseUri + $"api/incident/GetIncidentsOfEmployee?EmpID={employee.Id}")
    ?? new List<Incident>();



    }



    private void CreateNewIncident()
    {
        NavManager.NavigateTo($"/incidentForm/");
    }
}
