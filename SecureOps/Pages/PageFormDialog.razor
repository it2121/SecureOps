    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; }
    [Parameter] public int PageId { get; set; }



    private MudForm form;
    private Models.Page page = new Models.Page();

    private void CheckChanged(RoleSelection role, bool isChecked)
    {
        role.IsSelected = isChecked;
        StateHasChanged(); // make sure UI updates
    }
