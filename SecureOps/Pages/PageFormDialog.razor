            var roles = await Http.GetFromJsonAsync<List<Role>>(NavManager.BaseUri + "api/Role/GetAll");
            // Prepare list with check status
            allRoles = roles.Select(r => new RoleSelection
            {
                RoleId = r.RoleId,
                RoleName = r.RoleName,
                IsSelected = page.Roles?.Any(pr => pr.RoleId == r.RoleId) ?? false
            }).ToList();

        }
