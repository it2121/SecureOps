<h3> User Managment </h3>


@if (userDto == null)
{
    <p>Loading Data...</p>
}
else if (!userDto.Any())
{
    <p>No Data found.</p>
}
else
{


    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
        <MudText Typo="Typo.h5"></MudText>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="@(() => OpenRolesDialogAsync())">
            Roles
        </MudButton>

                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="@(() => OpenPageDialogAsync())">
            Pages
        </MudButton>
    </MudStack>
    <MudDataGrid ReadOnly="false"
                 @ref="grid"
                 T="UserDto"
                 MultiSelection="true"
                 Items="@userDto"
                 SortMode="SortMode.Multiple"
                 QuickFilter="@_quickFilter"
                 DragDropColumnReordering="true"
                 ColumnsPanelReordering="true"
                 Filterable="true" Groupable="true"
                 ShowMenuIcon="true"
                 Hideable="true" RowClick="@RowClicked"
                 RowContextMenuClick="RowRightClicked"
                 SelectedItemsChanged="@SelectedItemsChanged">
        <ToolBarContent>
            <MudText Typo="Typo.h6"> Users </MudText>
            <MudSpacer />
            <MudTextField @bind-Value="_searchString" Placeholder="Search" Adornment="Adornment.Start" Immediate="true"
                          AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
        </ToolBarContent>
        <Columns>
            <SelectColumn T="UserDto" />
            <PropertyColumn Property="x => x.FullName" Title="Title" />
            <PropertyColumn Property="x => x.Username" Title="Username" />
            <PropertyColumn Property="x => x.Email" Title="Email" />
    
            @* <PropertyColumn Property="x => x.UploadedAt" SortBy="@_sortBy" /> *@
            @* <PropertyColumn Property="x => x.UpdatedAt" />  *@
            @* <PropertyColumn Property="x => x.UploadedBy != null ? x.UploadedBy.FullName : string.Empty" Title="Full Name" /> *@
            @* <PropertyColumn Property="x => x.IsActive" Title="IsActive" /> *@
            @* <PropertyColumn Property="x => x.IsConfidential" Title="IsConfidential" /> *@
            @* <PropertyColumn Property="x => x.Category" Title="Category" />
            <PropertyColumn Property="x => x.Tags" Title="Tags" /> *@
            <TemplateColumn Title="Roles">
                <CellTemplate>
                    @foreach (var role in context.Item.Roles)
                    {
                        <MudChip   Icon="@Icons.Material.Filled.VerifiedUser" Color="Color.Info" Class="m-1">
                            @role.RoleName
                           
                        </MudChip>
                    }
                </CellTemplate>
            </TemplateColumn>

            <!-- Action Button Column -->
            <TemplateColumn Title="Actions" CellClass="">
                <CellTemplate>
                    <MudButton Color="Color.Primary"
                               Variant="Variant.Filled"
                               Size="Size.Small"
                               OnClick="@(async () => await OpenDialogAsync(context.Item.Id))">
                  
                                 
                          



                        View
                    </MudButton>
                </CellTemplate>
            </TemplateColumn>


        </Columns>
        <PagerContent>
            <MudDataGridPager T="UserDto" />
        </PagerContent>
    </MudDataGrid>

}
