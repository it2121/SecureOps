@page "/SDocument"
@using MudBlazor
@using SecureOps.Models
@using SecureOps.Models.Dto
@using MudBlazor.Utilities
@inject HttpClient Http
@inject NavigationManager NavManager
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
<h3> SDocument </h3>


@if (sdocumentDto == null)
{
    <p>Loading Data...</p>
}
else if (!sdocumentDto.Any())
{
    <p>No Data found.</p>
}
else
{
    <MudTextField @bind-Value="_searchString" Placeholder="Search users..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="mb-3" />

    <MudSimpleTable Items="Filtereddocuments" Hover="true" Dense="true" FixedHeader="true" Style="@(true ? "height:500px;" : "")">
        <thead>
            <tr>
                <th>Id</th>
                <th>Uploaded By</th>
                <th>Title</th>
                <th>File Size (bytes)</th>
                <th>Uploaded At</th>
                <th>Updated At</th>
                <th>Uploaded By (Employee Id)</th>
                <th>Is Active</th>
                <th>Is Confidential</th>
                <th>Category</th>
                <th>Tags</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var doc in Filtereddocuments)
            {
                <tr>
                    <td>@doc.Id</td>
                                <td>@doc.UploadedBy?.FullName</td> <!-- 👈 show employee name -->


                    <td>@doc.Title</td>
                    <td>@doc.FileSize</td>
                    <td>@doc.UploadedAt.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@doc.UpdatedAt?.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@doc.UploadedById</td>
                    <td>@doc.IsActive</td>
                    <td>@doc.IsConfidential</td>
                    <td>@doc.Category</td>
                    <td>@doc.Tags</td>
                </tr>
            }
        </tbody>
    </MudSimpleTable>


}
@code {
    // private List<User> user;
    private List<SDocumentDto> sdocumentDto;
    private string _colorValue;
    private string _searchString = "";
    private Employee employee;
    protected override async Task OnInitializedAsync()
    {
        var token = await LocalStorage.GetItemAsync<string>("authToken");

        if (!string.IsNullOrEmpty(token))
        {
        employee = JwtHelper.DecodeTokenToEmployee(token);
            User? currentUser = JwtHelper.DecodeTokenToUser(token);





       

            if( currentUser.Roles.Any(r =>
               r.RoleName.Equals("Admin", StringComparison.OrdinalIgnoreCase) ))
            {
                sdocumentDto = await Http.GetFromJsonAsync<List<SDocumentDto>>(NavManager.BaseUri + $"api/SDocument/GetAll");

            }
            else
            {
                sdocumentDto = await Http.GetFromJsonAsync<List<SDocumentDto>>(NavManager.BaseUri + $"api/SDocument/GetSDocumentOfEmployee?EmpID={employee.Id}");
            }
        }
    
    
    
    }
    private IEnumerable<SDocumentDto> Filtereddocuments =>
            string.IsNullOrWhiteSpace(_searchString)
                ? sdocumentDto
                : sdocumentDto.Where(u =>
                    (u.Title?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (u.Tags?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (u.Category?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false));



}
