@page "/SDocument"
@using MudBlazor
@using SecureOps.Models
@using SecureOps.Models.Dto
@using MudBlazor.Utilities
@inject HttpClient Http
@inject NavigationManager NavManager
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@using System.Net.Http.Json
@inject HttpClient httpClient

<h3> SDocument </h3>


@if (sdocumentDto == null)
{
    <p>Loading Data...</p>
}
else if (!sdocumentDto.Any())
{
    <p>No Data found.</p>
}
else
{
    @* <MudTextField @bind-Value="_searchString" Placeholder="Search users..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="mb-3" /> *@

    @* <MudSimpleTable Items="Filtereddocuments" Hover="true" Dense="true" FixedHeader="true" Style="@(true ? "height:500px;" : "")">
        <thead>
            <tr>
                <th>Id</th>
