            }
        </tbody>
    </MudSimpleTable> *@


    <MudDataGrid  ReadOnly="false"  
        @ref="grid"  
        T="SDocumentDto" 
        MultiSelection="true"
                 Items="@sdocumentDto"
                 SortMode="SortMode.Multiple"   
                 QuickFilter="@_quickFilter" 
              DragDropColumnReordering="true"
              ColumnsPanelReordering="true"
                 Filterable="true" Groupable="true" 
                 ShowMenuIcon="true"
                 Hideable="true" RowClick="@RowClicked"
                 RowContextMenuClick="RowRightClicked" 
                 SelectedItemsChanged="@SelectedItemsChanged">
        <ToolBarContent>
            <MudText Typo="Typo.h6"> SDocument</MudText>
            <MudSpacer />
            <MudTextField @bind-Value="_searchString" Placeholder="Search" Adornment="Adornment.Start" Immediate="true"
                          AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
        </ToolBarContent>
        <Columns>
            <SelectColumn T="SDocumentDto"  />
            <PropertyColumn Property="x => x.Title" Title="Title"  />
            <PropertyColumn Property="x => x.FileSize" />
            <PropertyColumn Property="x => x.UploadedAt" SortBy="@_sortBy" />
            @* <PropertyColumn Property="x => x.UpdatedAt" />  *@
            @* <PropertyColumn Property="x => x.UploadedBy != null ? x.UploadedBy.FullName : string.Empty" Title="Full Name" /> *@
            @* <PropertyColumn Property="x => x.IsActive" Title="IsActive" /> *@
            @* <PropertyColumn Property="x => x.IsConfidential" Title="IsConfidential" /> *@
            <PropertyColumn Property="x => x.Category" Title="Category" />
            <PropertyColumn Property="x => x.Tags" Title="Tags" />

            <!-- Action Button Column -->
            <TemplateColumn Title="Actions" CellClass="d-flex justify-center">
                <CellTemplate>
                    <MudButton Color="Color.Primary"
                               Variant="Variant.Filled"
                               Size="Size.Small"
                               OnClick="@(async () => await OnActionButtonClicked(context.Item.Id))">
                        View
                    </MudButton>
                </CellTemplate>
            </TemplateColumn>


        </Columns>
        <PagerContent>
            <MudDataGridPager T="SDocumentDto" />
        </PagerContent>
    </MudDataGrid>

}
@code {
    


    private async Task OnActionButtonClicked(int documentId)
    {
        Console.WriteLine($"Document ID clicked: {documentId}");

        // Example: navigate to a detail page
        // NavManager.NavigateTo($"/SDocumentDetail/{documentId}");

        // Or call your API
        // var result = await Http.GetFromJsonAsync<SDocumentDto>($"api/SDocument/{documentId}");
    }
  

    public MudDataGrid<SDocumentDto> grid = null;

    private async Task HideColumnsAsync(bool hide)
    {
        foreach (var column in grid.RenderedColumns)
        {
            if (hide)
            {
                await column.HideAsync();
            }
            else
            {
                await column.ShowAsync();
            }
        }
        ;
    }


    private IEnumerable<SDocumentDto> sdocumentDto = new List<SDocumentDto>();
   // private List<SDocumentDto> sdocumentDto;
    private string _searchString;
    private bool _sortNameByLength;
    private List<string> _events = new();
    // custom sort by name length
    private Func<SDocumentDto, object> _sortBy => x =>
    {
        if (_sortNameByLength)
            return x.Title.Length;
        else
            return x.Category;
    };
    // quick filter - filter globally across multiple columns with the same input
    private Func<SDocumentDto, bool> _quickFilter => x =>
    {
        if (string.IsNullOrWhiteSpace(_searchString))
            return true;

        if (x.Title.Contains(_searchString, StringComparison.OrdinalIgnoreCase))
            return true;

        if (x.Category.Contains(_searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if (x.Tags.Contains(_searchString, StringComparison.OrdinalIgnoreCase))
            return true;

   

        return false;
    };


    // events
    void RowClicked(DataGridRowClickEventArgs<SDocumentDto> args)
    {
        _events.Insert(0, $"Event = RowClick, Index = {args.RowIndex}, Data = {System.Text.Json.JsonSerializer.Serialize(args.Item)}");
    
        
    
    }

    void RowRightClicked(DataGridRowClickEventArgs<SDocumentDto> args)
    {
        _events.Insert(0, $"Event = RowRightClick, Index = {args.RowIndex}, Data = {System.Text.Json.JsonSerializer.Serialize(args.Item)}");
    }

    void SelectedItemsChanged(HashSet<SDocumentDto> items)
    {
        _events.Insert(0, $"Event = SelectedItemsChanged, Data = {System.Text.Json.JsonSerializer.Serialize(items)}");
    }




    // private List<User> user;
    private string _colorValue;
    private Employee employee;
    protected override async Task OnInitializedAsync()
    {
        var token = await LocalStorage.GetItemAsync<string>("authToken");

        if (!string.IsNullOrEmpty(token))
        {
        employee = JwtHelper.DecodeTokenToEmployee(token);
            User? currentUser = JwtHelper.DecodeTokenToUser(token);





       

            if( currentUser.Roles.Any(r =>
               r.RoleName.Equals("Admin", StringComparison.OrdinalIgnoreCase) ))
            {
                sdocumentDto = await Http.GetFromJsonAsync<List<SDocumentDto>>(NavManager.BaseUri + $"api/SDocument/GetAll");

            }
            else
            {
                sdocumentDto = await Http.GetFromJsonAsync<List<SDocumentDto>>(NavManager.BaseUri + $"api/SDocument/GetSDocumentOfEmployee?EmpID={employee.Id}");
            }
        }
    
    
    
    }
    private IEnumerable<SDocumentDto> Filtereddocuments =>
            string.IsNullOrWhiteSpace(_searchString)
                ? sdocumentDto
                : sdocumentDto.Where(u =>
                    (u.Title?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (u.Tags?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (u.Category?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ?? false));



}
