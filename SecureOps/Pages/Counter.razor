@page "/counter"
@inject AuthenticationStateProvider AuthStateProvider


@attribute [Authorize(Roles = "SafetyManager,FieldEmployee")]

<PageTitle>Counter</PageTitle>


<h3>Manager Dashboard</h3>

<h1>Counter</h1>

<p role="status">Current count: @currentCount</p>

<button class="btn btn-primary" @onclick="IncrementCount">Click me</button>


@if (showSpecialFeatures)
{
    <div class="alert alert-success">
        <h4>High-Level Features</h4>
        <ul>
            <li>Manage Safety Tasks</li>
            <li>Approve Incidents</li>
            <li>Access Supervisor Reports</li>
        </ul>
    </div>
}
else
{
    <div class="alert alert-danger">
        <p>You have access to standard features.</p>
        <ul>
            <li>View My Tasks</li>
            <li>Report an Incident</li>
            <li>Download Training Documents</li>
        </ul>
    </div>
}
@code {
    private int currentCount = 0;

    private void IncrementCount()
    {
        currentCount++;
    }

    private bool showSpecialFeatures =false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.IsInRole("SafetyManager") || user.IsInRole("FieldEmployee"))
        {
            showSpecialFeatures = true;
        }
    }


}
