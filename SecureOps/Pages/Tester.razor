@page "/Tester"
@using System.Security.Claims
@using SecureOps.Models
@using SecureOps.Models.Dto
@inject AuthenticationStateProvider AuthStateProvider
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@inject NavigationManager NavManager
@inject JwtAuthenticationStateProvider AuthStateProvider
@inject HttpClient Http
<h3>User Info</h3>

@if (claims != null)
{
    <ul>
        @foreach (var claim in claims)
        {
            <li><b>@claim.Type:</b> @claim.Value</li>
        }
    </ul>

    <h4>Roles</h4>
    <ul>
        @foreach (var role in roles)
        {
            <li>@role</li>
        }
    </ul>
    <h4>Employee</h4>
    <ul>
        @if (empExist){
        <li>@employee.FullName</li>
        <li>@employee.JobTitle</li>
        <li>@employee.Email</li>
        <li>@employee.UserId</li>
        <li>@employee.Id</li>
        }
        else
        {

            <li>No EMp is set</li>


        }
    </ul>
}
else
{
    <p>No user is logged in.</p>
}

@code {
    private IEnumerable<System.Security.Claims.Claim> claims;
    private IEnumerable<string> roles;
    bool empExist = false;
    EmployeeDto employee;
    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var token = await LocalStorage.GetItemAsync<string>("authToken");
        var employeeIdClaim = user.FindFirst("employeeId")?.Value;
         empExist = int.TryParse(employeeIdClaim, out var empId);


        if (empExist)
        {
            employee = await JwtHelper.DecodeFromDatabaseTokenToEmployeeAsync(token, Http, NavManager.BaseUri);
        }
        else
        {
            employee = null;
        }




        if (user.Identity != null && user.Identity.IsAuthenticated)
        {
            claims = user.Claims;
            roles = user.FindAll(ClaimTypes.Role).Select(c => c.Value);

        }
    }
}
