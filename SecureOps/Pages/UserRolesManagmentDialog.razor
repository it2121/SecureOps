            yesText: "Delete!", cancelText: "Cancel");





        if (result != null)
        {
            // await DeleteImageAsync(imageUrl);
        }
    }


    private void AddRole(Role role)
    {
        if (role != null && !roles.Any(r => r.RoleId == role.RoleId))
        {
            roles.Add(role);
            selectedRole = null;
            StateHasChanged();
        }
    }

    private void RemoveRole(Role role)
    {
        if (roles.Contains(role))
        {
            roles.Remove(role);
            StateHasChanged();
        }
    }

    private async Task OnButtonClickedAsync(Role role)
    {
        bool? result = await _mudMessageBox.ShowAsync();
        _state = result is null ? false : true;

        if (_state)
        {

            var response = await Http.DeleteAsync(NavManager.BaseUri + $"api/Users/RemoveRoleFromUser?UserId={UserId}&RoleID={role.RoleId}");

            if (response.IsSuccessStatusCode)
            {
                var roleToRemove = roles.FirstOrDefault(r => r.RoleId == role.RoleId);
                if (roleToRemove != null)
                {
                    roles.Remove(roleToRemove);
                }
                StateHasChanged();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
            }
            Snackbar.Add("Deleted Successfully!", Severity.Success);

        }
        StateHasChanged();
    }




    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; }
    [Parameter] public int UserId { get; set; }

    private Employee employee;
    private MudForm form;
    private UserDto userDto = new UserDto();

    private async void Submit()
    {
        await SaveRoles();
    }

    private void Cancel() => MudDialog.Cancel();

    protected override async Task OnInitializedAsync()
    {
        var token = await LocalStorage.GetItemAsync<string>("authToken");

        if (UserId != 0)
        {
            UserDto tempUserDto = await Http.GetFromJsonAsync<UserDto>(NavManager.BaseUri + $"api/Users/GetUser/{UserId}");
            userDto = tempUserDto;
            roles = userDto.Roles.ToList();
            allRoles = await Http.GetFromJsonAsync<List<Role>>(NavManager.BaseUri + $"api/Users/GetNotUserRoles/{UserId}");

        }
        else
        {
            //incident.Id = await Http.GetFromJsonAsync<int>(NavManager.BaseUri + $"api/incident/GetNextIncidentID");
        }
    }

    private Task<IEnumerable<Role>> SearchRolesAsync(string value)
    {
        var availableRoles = allRoles
            .Where(r => !roles.Any(ur => ur.RoleId == r.RoleId));

        if (!string.IsNullOrWhiteSpace(value))
            availableRoles = availableRoles
                .Where(r => r.RoleName.Contains(value, StringComparison.OrdinalIgnoreCase));

        return Task.FromResult(availableRoles.AsEnumerable());
    }
    private async Task OnRemoveNewRoleClicked(Role role)
    {
        NewAddedRoles.Remove(role);
        StateHasChanged();
        Snackbar.Add($"Role {role.RoleName} removed", Severity.Success);
    
}
private async Task OnRemoveRoleClicked(Role role)
{
        var response = await Http.DeleteAsync(NavManager.BaseUri + $"api/Users/RemoveRoleFromUser/{UserId}/{role.RoleId}");
    if (response.IsSuccessStatusCode)
    {
        roles.Remove(role);
        StateHasChanged();
        Snackbar.Add($"Role {role.RoleName} removed", Severity.Success);
    }
}
private void OnRoleSelected(Role role)
{
    if (role != null && !roles.Any(r => r.RoleId == role.RoleId))
    {
        roles.Add(role);
        selectedRole = null; // reset autocomplete
        StateHasChanged();
    }
}
