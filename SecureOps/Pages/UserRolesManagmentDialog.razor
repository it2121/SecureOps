    private Task<IEnumerable<Role>> SearchRolesAsync(string value)
    {
        var availableRoles = allRoles
            .Where(r => !roles.Any(ur => ur.RoleId == r.RoleId));

        if (!string.IsNullOrWhiteSpace(value))
            availableRoles = availableRoles
                .Where(r => r.RoleName.Contains(value, StringComparison.OrdinalIgnoreCase));

        return Task.FromResult(availableRoles.AsEnumerable());
    }
private async Task OnRemoveRoleClicked(Role role)
{
    var response = await Http.DeleteAsync(NavManager.BaseUri +$"api/Users/RemoveRoleFromUser/{UserId}/{role.RoleId}");
    if (response.IsSuccessStatusCode)
    {
        roles.Remove(role);
        StateHasChanged();
        Snackbar.Add($"Role {role.RoleName} removed", Severity.Success);
    }
}
private void OnRoleSelected(Role role)
{
    if (role != null && !roles.Any(r => r.RoleId == role.RoleId))
    {
        roles.Add(role);
        selectedRole = null; // reset autocomplete
        StateHasChanged();
    }
