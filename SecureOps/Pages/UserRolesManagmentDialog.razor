    private async Task<IEnumerable<Role>> Search1(string value, CancellationToken token)
    {
        // return await Http.GetFromJsonAsync<List<Role>>(NavManager.BaseUri + $"api/Users/GetAllRoles");
        var roles = await Http.GetFromJsonAsync<List<Role>>(NavManager.BaseUri + $"api/Users/GetNotUserRoles/{UserId}");

        if (string.IsNullOrWhiteSpace(value))
            return roles; // if nothing typed, return all

        // Filter by RoleName (case-insensitive)
        return roles.Where(r => r.RoleName.Contains(value, StringComparison.OrdinalIgnoreCase));

    }
    private Role selectedRole;
    private List<Role> allRoles = new();
    Role AutoRole;
    private List<Role> roles = new List<Role>();
    private List<Role> NewAddedRoles = new List<Role>();
    private MudMessageBox _mudMessageBox;
    private bool _state = false;




    private async Task AddRole()
    {
        Role selectedRole = AutoRole;



        if (!NewAddedRoles.Any(r => r.RoleId == selectedRole.RoleId))
        {
            NewAddedRoles.Add(selectedRole);
        }



        AutoRole = null;

        StateHasChanged();

    }



