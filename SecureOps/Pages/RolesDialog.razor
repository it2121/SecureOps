               TitleClass="blur dialog-background-title"
               ContentClass="dialog-background-surface py-10"
               ActionsClass="dialog-background-surface" @ref="_mudMessageBox" Title="Warning" CancelText="Cancel">
    <MessageContent > 
        Deleting can <b><i>not</i></b> be undone!
    </MessageContent>
    <YesButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.DeleteForever">Delete!</MudButton>
    </YesButton>
</MudMessageBox> *@




<style>
    .custom-dialog {
        width: 1300px !important;
        max-width: 90vw;
    }

    .blur {
        backdrop-filter: blur(10px);
    }

    .dialog-background {
        background-color: transparent;
    }

    .dialog-background-title {
        background: rgb(from var(--mud-palette-info-lighten) r g b / 50%);
        color: var(--mud-palette-white);
    }

    .dialog-background-surface {
        background: rgb(from var(--mud-palette-surface) r g b / 45%);
    }

    .dialog-background-container {
        background: rgb(from var(--mud-palette-surface) r g b / 85%);
    }

</style>




@code {
    bool ShowMessage = false;
    private MudForm form;
    private MudForm Messageform;
    public MudDataGrid<Role> grid = null;

    private async Task HideColumnsAsync(bool hide)
    {
        foreach (var column in grid.RenderedColumns)
        {
            if (hide)
            {
                await column.HideAsync();
            }
            else
            {
                await column.ShowAsync();
            }
        }
        ;
    }

    private string _searchString;
    private bool _sortNameByLength;
    private List<string> _events = new();
    private Func<Role, object> _sortBy => x =>
    {
        if (_sortNameByLength)
            return x.RoleName.Length;
        else return x.RoleName.Length;


    };
    private Func<Role, bool> _quickFilter => x =>
    {
        if (string.IsNullOrWhiteSpace(_searchString))
            return true;

        if (x.RoleName.Contains(_searchString, StringComparison.OrdinalIgnoreCase))
            return true;




        return false;
    };


    // events
    void RowClicked(DataGridRowClickEventArgs<Role> args)
    {
        _events.Insert(0, $"Event = RowClick, Index = {args.RowIndex}, Data = {System.Text.Json.JsonSerializer.Serialize(args.Item)}");



    }

    void RowRightClicked(DataGridRowClickEventArgs<Role> args)
    {
        _events.Insert(0, $"Event = RowRightClick, Index = {args.RowIndex}, Data = {System.Text.Json.JsonSerializer.Serialize(args.Item)}");
    }

    void SelectedItemsChanged(HashSet<Role> items)
    {
        _events.Insert(0, $"Event = SelectedItemsChanged, Data = {System.Text.Json.JsonSerializer.Serialize(items)}");
    }



    private MudMessageBox _mudMessageBox;
    private bool _state = false;
    private readonly DialogOptions _maxWidth = new() { MaxWidth = MaxWidth.Medium, FullWidth = true };

    private async Task OnButtonClickedAsync(int roleId)
    {
        ShowMessage = true;
        StateHasChanged();
        bool? result = await _mudMessageBox.ShowAsync(_maxWidth);
        _state = result is null ? false : true;

        if (_state)
        {

            var response = await Http.DeleteAsync(NavManager.BaseUri + $"api/Role/{roleId}");

            if (response.IsSuccessStatusCode)
            {
                var ToRemove = roles.FirstOrDefault(i => i.RoleId == roleId);
                if (ToRemove is not null)
                    roles.Remove(ToRemove);
                ShowMessage = false;

                StateHasChanged();
            }
            Snackbar.Add("Deleted Successfully!", Severity.Success);

        }
        else
        {
            ShowMessage = false;
            
        }
        StateHasChanged();
    }
    private async Task DeleteRole(int roleId)
    {
        var response = await Http.DeleteAsync(NavManager.BaseUri + $"api/Role/{roleId}");

        if (response.IsSuccessStatusCode)
        {

            var ToRemove = roles.FirstOrDefault(i => i.RoleId == roleId);
            if (ToRemove is not null)
                roles.Remove(ToRemove);




            StateHasChanged();


        }

    }


    private async Task OpenDeleteDialogAsync(int roleId)
    {

        var options = new DialogOptions { CloseOnEscapeKey = true, CloseButton = true };


        var dialog = await DialogService.ShowAsync<DeleteConfirmDialog>("Dialog", options);

        var result = await dialog.Result;

        if (!result.Canceled)
        {

            // roles = await Http.GetFromJsonAsync<List<Role>>(NavManager.BaseUri + $"api/Role/GetAll")
            //  ?? new List<Role>();



            var response = await Http.DeleteAsync(NavManager.BaseUri + $"api/Role/{roleId}");

            if (response.IsSuccessStatusCode)
            {
                var ToRemove = roles.FirstOrDefault(i => i.RoleId == roleId);
                if (ToRemove is not null)
                    roles.Remove(ToRemove);
                ShowMessage = false;

                StateHasChanged();
            }
            Snackbar.Add("Deleted Successfully!", Severity.Success);


            return;
        }
        else
        {
            return;
        }

    }
    private async Task OpenDialogAsync(int roleId)
    {

        var options = new DialogOptions { CloseOnEscapeKey = true, CloseButton = true };

        var parameters = new DialogParameters
        {
            { "RoleId", roleId } ,
        };

        var dialog = await DialogService.ShowAsync<RoleFormDialog>("Dialog", parameters, options);

        var result = await dialog.Result;

        if (!result.Canceled)
        {

            roles = await Http.GetFromJsonAsync<List<Role>>(NavManager.BaseUri + $"api/Role/GetAll")
             ?? new List<Role>();





            var returnedValue = result.Data;

            if (roleId == 0)
            {
                Snackbar.Add($"Incident added Successfully!", Severity.Success);
            }
            else
            {
                Snackbar.Add($"Incident edited Successfully!", Severity.Success);

            }
            return;
        }
        else
        {
            return;
        }

    }


    private string _colorValue;


    private List<Role> roles = new();



  





    protected override async Task OnInitializedAsync()
    {

    


        roles = await Http.GetFromJsonAsync<List<Role>>(NavManager.BaseUri + $"api/Role/GetAll")
    ?? new List<Role>();



    }

}
