@using MudBlazor
@using SecureOps.Models
@using SecureOps.Models.Dto
@using System.Text.Json
@using System.Text
@using MudBlazor.Extensions;
@using MudBlazor.Extensions.Options;
@inject HttpClient Http
@inject NavigationManager NavManager
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@inject ISnackbar Snackbar
@inject IDialogService DialogService


<MudDialog Class="custom-dialog blur dialog-background"
TitleClass="blur dialog-background-title"
ContentClass="dialog-background-surface py-10"
ActionsClass="dialog-background-surface">
   <TitleContent>
        <MudText Typo="Typo.h5">Roles</MudText>
    </TitleContent>
      <DialogContent>
  <MudForm @ref="form" Class="mt-4">
    @if (roles == null)
    {
        <MudText Typo="Typo.body1">Loading...</MudText>
    }
    else
    {
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
            <MudText Typo="Typo.h5">Roles Managment</MudText>
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="@(() => OpenDialogAsync(0))">
                + New Incident
            </MudButton>
        </MudStack>


        @if (roles == null || !roles.Any())
        {
            <MudText Typo="Typo.body1">No Roles found.</MudText>
        }
        else
        {
          

            <MudDataGrid ReadOnly="false"
                         @ref="grid"
                         T="Role"
                         MultiSelection="true"
                         Items="@roles"
                         SortMode="SortMode.Multiple"
                         QuickFilter="@_quickFilter"
                         DragDropColumnReordering="true"
                         ColumnsPanelReordering="true"
                         Filterable="true" Groupable="true"
                         ShowMenuIcon="true"
                         Hideable="true" RowClick="@RowClicked"
                         RowContextMenuClick="RowRightClicked"
                         SelectedItemsChanged="@SelectedItemsChanged">
                <ToolBarContent>
                    <MudText Typo="Typo.h6"> Roles</MudText>
                    <MudSpacer />
                    <MudTextField @bind-Value="_searchString" Placeholder="Search" Adornment="Adornment.Start" Immediate="true"
                                  AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
                </ToolBarContent>
                <Columns>
                    <SelectColumn T="Role" />
                    <PropertyColumn Property="x => x.RoleName" Title="Role Name" />
          


                    <!-- Action Button Column -->
                    <TemplateColumn Title="Actions" CellClass="d-flex justify-center">
                        <CellTemplate>
                            <MudStack Row="true" Spacing="3" T="string" Class="d-flex flex-wrap">
                                <MudButton Color="Color.Primary"
                                           Variant="Variant.Filled"
                                           Size="Size.Small"
                                           OnClick="@(async () => await OpenDialogAsync(context.Item.RoleId))">
                                    View
                                </MudButton>

                                <MudButton Color="Color.Error"
                                           Variant="Variant.Filled"
                                           Size="Size.Small"
                                                   OnClick="@(async () => await OpenDeleteDialogAsync(context.Item.RoleId))">
                                           @* OnClick="@(async () => await OnButtonClickedAsync(context.Item.RoleId))"> *@
                                    Delete
                                </MudButton>

                            </MudStack>
                        </CellTemplate>
                    </TemplateColumn>


                </Columns>
                <PagerContent>
                    <MudDataGridPager T="Role" />
                </PagerContent>
            </MudDataGrid>



        }
    }

        </MudForm>
  </DialogContent>
  


    </MudDialog>

@* 
