@using MudBlazor
@using SecureOps.Models
@using SecureOps.Models.Dto
@using System.Text.Json
@using System.Text
@using MudBlazor.Extensions;
@using MudBlazor.Extensions.Options;
@inject HttpClient Http
@inject NavigationManager NavManager
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudDialog Class="custom-dialog blur dialog-background"
           TitleClass="blur dialog-background-title"
           ContentClass="dialog-background-surface py-10"
           ActionsClass="dialog-background-surface">

    <TitleContent>
        <MudText Typo="Typo.h5">Assign Employee</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="form" Class="mt-4">
            <MudStack Spacing="3">
                <MudPaper Class="pa-4  dialog-background-container">
                    <MudTextField ReadOnly="true" @bind-Value="safetyTask.Title" Label="safety Task"
                                  Required="true" For="@(() => safetyTask.Title)" />
                </MudPaper>
                <MudDivider />


                <MudItem xs="12">

                    <MudAutocomplete T="Employee" Label="Employees" @bind-Value="AutoEmployee" SearchFunc="@Search1"
                                     ResetValueOnEmptyText="true"
                                     CoerceText="true" CoerceValue="true" SelectValueOnTab="true"
                                     ToStringFunc="@(e=> e==null?null : $"{e.FullName} ,{e.JobTitle} ")" />



                </MudItem>


            </MudStack>
        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="Cancel">
            Cancel
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Submit">
            Save
        </MudButton>
    </DialogActions>
</MudDialog>





<style>
    .custom-dialog {
        width: 1300px !important;
        max-width: 90vw;
    }

    .blur {
        backdrop-filter: blur(10px);
    }

    .dialog-background {
        background-color: transparent;
    }

    .dialog-background-title {
        background: rgb(from var(--mud-palette-info-lighten) r g b / 50%);
        color: var(--mud-palette-white);
    }

    .dialog-background-surface {
        background: rgb(from var(--mud-palette-surface) r g b / 45%);
    }

    .dialog-background-container {
        background: rgb(from var(--mud-palette-surface) r g b / 85%);
    }

</style>

@code {





    private List<string> imageUrls = new List<string>();
    private MudMessageBox _mudMessageBox;
    private bool _state = false;






    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; }
    public int EmployeeId;
    [Parameter] public int SaftyTaskId { get; set; }

    Employee AutoEmployee;

    private MudForm form;
    private SafetyTask safetyTask = new SafetyTask();

    private async void Submit()
    {
        await SaveIncident();
    }
    private async Task<IEnumerable<Employee>> Search1(string value, CancellationToken token)
    {
        // return await Http.GetFromJsonAsync<List<Role>>(NavManager.BaseUri + $"api/Users/GetAllRoles");
        var employees = await Http.GetFromJsonAsync<List<Employee>>(NavManager.BaseUri + $"api/Employee/GetAll");

        if (string.IsNullOrWhiteSpace(value))
            return employees; // if nothing typed, return all

        // Filter by RoleName (case-insensitive)
        return employees.Where(r =>
            r.FullName.Contains(value, StringComparison.OrdinalIgnoreCase) ||
            r.JobTitle.Contains(value, StringComparison.OrdinalIgnoreCase));
    }
    private void Cancel() => MudDialog.Cancel();

    protected override async Task OnInitializedAsync()
    {
        var token = await LocalStorage.GetItemAsync<string>("authToken");



        if (SaftyTaskId != 0)
        {
            SafetyTask tempSafetyTask = await Http.GetFromJsonAsync<SafetyTask>(NavManager.BaseUri + $"api/SaftyTask/GetSafetyTask?SafetyTaskId={SaftyTaskId}");
            safetyTask = tempSafetyTask;
            AutoEmployee = safetyTask.Employee;

        }
        else
        {
        }
    }

    private async Task SaveIncident()
    {
        await form.Validate();
        if (!form.IsValid)
            return;




        bool okay = true;

        using var content = new MultipartFormDataContent();

        safetyTask.EmployeeId = AutoEmployee.Id;
        safetyTask.Employee = AutoEmployee;
        var safetyTaskJson = new StringContent(JsonSerializer.Serialize(safetyTask), Encoding.UTF8, "application/json");
        content.Add(safetyTaskJson, "safetyTaskJson");



        var response = await Http.PostAsync(NavManager.BaseUri + "api/SaftyTask/UpdateAssignedEmployee", content);

        if (response.IsSuccessStatusCode)
        {

        }

        if (!response.IsSuccessStatusCode)
        {
            okay = false;
        }

        if (okay)
        {
            MudDialog.Close(DialogResult.Ok(true));
        }
    }
}
