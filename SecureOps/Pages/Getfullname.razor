@page "/Getfullname"
@using Microsoft.AspNetCore.Identity
@using SecureOps.Data
@inject UserManager<ApplicationUser> UserManager

<h3>Find User Full Name</h3>

<InputText @bind-Value="email" placeholder="Enter email" class="form-control mb-2" />
<button class="btn btn-primary mb-2" @onclick="GetFullName">Get Full Name</button>

@if (!string.IsNullOrEmpty(fullName))
{
    <div class="alert alert-success">Full Name: @fullName</div>
}
@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

@code {
    private string email;
    private string fullName;
    private string errorMessage;

    private async Task GetFullName()
    {
        errorMessage = fullName = null;

        var user = await UserManager.FindByEmailAsync(email);
        if (user != null)
        {
            fullName = user.FullName;
        }
        else
        {
            errorMessage = "User not found.";
        }
    }
}
