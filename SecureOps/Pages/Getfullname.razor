@page "/Getfullname"
@using Microsoft.AspNetCore.Identity
@using SecureOps.Data
@using SecureOps.Models
@using SecureOps.Models.Dto
@using System.Net.Http.Headers
@using static System.Net.WebRequestMethods
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage

@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager NavManager
@inject HttpClient Http
<h3>Find User Full Name</h3>

<InputText @bind-Value="email" placeholder="Enter email" class="form-control mb-2" />
<button class="btn btn-primary mb-2" @onclick="GetFullName">Get Full Name</button>

@if (!string.IsNullOrEmpty(fullName))
{
    <div class="alert alert-success">Full Name: @fullName</div>
}
@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

@code {
    private string email;
    private string fullName;
    private string errorMessage;

    private async Task GetFullName()
    {
        fullName = errorMessage = null;

        try
        {
            // If using JWT, add Authorization header
            var jwt = await LocalStorage.GetItemAsync<string>("authToken");
            Http.DefaultRequestHeaders.Authorization =
                new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", jwt);

            var response = await Http.GetAsync(NavManager.BaseUri + $"api/Users/GetNameFromEmail?email={email}");

            if (response.IsSuccessStatusCode)
            {
                var userDto = await response.Content.ReadFromJsonAsync<UserDto>();
                fullName = userDto?.FullName;
            }
            else
            {
                errorMessage = await response.Content.ReadAsStringAsync();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        
    }
}
